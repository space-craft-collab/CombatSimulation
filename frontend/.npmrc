# Supply-chain rules, see CONTRIBUTING.md ("Frontend dependencies").
# Exact versions only, no ^ or ~ ranges.
save-exact=true
# No package runs code while it is installed.
ignore-scripts=true
# A version must be a week old before it is resolved; malware in a
# fresh release is usually found within days.
min-release-age=7
engine-strict=true
# No "new npm version" notices; the npm in the image is the pinned one.
update-notifier=false
