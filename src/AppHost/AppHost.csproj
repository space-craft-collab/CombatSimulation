<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AppHost: the composition root (ADR-0001/0002). The Orleans
    silo is co-hosted here via UseOrleans() — one process, one
    deployable.
  -->

  <PropertyGroup>
    <!-- Program sits in the global namespace: top-level
         statements plus the partial marker for tests. -->
    <NoWarn>$(NoWarn);CA1050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The OpenAPI document for the frontend's Kiota client (ADR-0004). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <!-- The turn-deadline reminder (ADR-0007); Server does not carry reminders. -->
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <!-- Table Storage providers, chosen by configuration (Phase 3). -->
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" />
    <PackageReference Include="Microsoft.Orleans.Reminders.AzureStorage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog\Catalog.csproj" />
    <ProjectReference Include="..\Battles\Battles.csproj" />
    <ProjectReference Include="..\Players\Players.csproj" />
    <ProjectReference Include="..\Battles.Grains.Abstractions\Battles.Grains.Abstractions.csproj" />
    <ProjectReference Include="..\Shared.Infrastructure\Shared.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- A template to copy, never shipped with the build. -->
    <Content Update="appsettings.Development.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
