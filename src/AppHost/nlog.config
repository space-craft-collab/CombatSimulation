<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <!-- Minimal Phase 1 setup (ADR-0006): console only. File /
       structured targets can be added here without a redeploy. -->

  <targets>
    <target xsi:type="ColoredConsole"
            name="console"
            layout="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}${onexception:|${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Startup banner ("Now listening on: ...", shutdown) is the
         one Microsoft.* Info source worth keeping — it must come
         before the framework-noise filters below. -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console" final="true" />

    <!-- Framework noise: warnings and above only. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>

</nlog>
