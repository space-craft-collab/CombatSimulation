<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Battles module (ADR-0009): one project, layered internally
    via Domain/ Features/ Infrastructure/ folders plus Grains/
    for the grain implementations. Consumes Catalog and Players
    via their Contracts projects only (ADR-0005).
    Microsoft.Orleans.Runtime carries IPersistentState<T>, which
    the stateful grains need; the abstractions project stays on
    the lighter Orleans.Sdk.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.Kernel\Shared.Kernel.csproj" />
    <ProjectReference Include="..\Shared.Infrastructure\Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\Battles.Contracts\Battles.Contracts.csproj" />
    <ProjectReference Include="..\Battles.Grains.Abstractions\Battles.Grains.Abstractions.csproj" />
    <ProjectReference Include="..\Catalog.Contracts\Catalog.Contracts.csproj" />
    <ProjectReference Include="..\Players.Contracts\Players.Contracts.csproj" />
  </ItemGroup>

</Project>
