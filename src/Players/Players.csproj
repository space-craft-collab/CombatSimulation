<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Players module (ADR-0009): one project, layered internally
    via Domain/ Features/ Infrastructure/ folders. ASP.NET Core
    types come from the shared framework, not NuGet.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.Kernel\Shared.Kernel.csproj" />
    <ProjectReference Include="..\Shared.Infrastructure\Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\Players.Contracts\Players.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the endpoint tests read the internal response types. -->
    <InternalsVisibleTo Include="OrleansMonsterArena.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: lets `dotnet ef` build migrations here. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
