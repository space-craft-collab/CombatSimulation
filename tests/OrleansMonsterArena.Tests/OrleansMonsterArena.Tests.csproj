<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test project (xUnit v3): host + silo tests on a shared
    Testcontainers SQL Server, the NetArchTest layering guard
    from ADR-0009, and slow integration scenarios (trait
    Category=Integration) with containers of their own.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests start the images pinned in compose.yaml (ComposeImages). -->
    <None Include="..\..\compose.yaml" Link="compose.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AppHost\AppHost.csproj" />
    <ProjectReference Include="..\..\src\Catalog\Catalog.csproj" />
    <ProjectReference Include="..\..\src\Battles\Battles.csproj" />
    <ProjectReference Include="..\..\src\Battles.Grains.Abstractions\Battles.Grains.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Players\Players.csproj" />
  </ItemGroup>

</Project>
